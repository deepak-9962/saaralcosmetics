# =============================================================================
# SAARAL COSMETICS — ENVIRONMENT CONFIGURATION
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. PUBLIC CLIENT VARIABLES (Exposed to the browser via NEXT_PUBLIC_)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://tmcfyzcfcrjzdwnquvhf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Razorpay Key ID (Public key used by Razorpay Checkout modal in browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Checkout Mode Configuration
# Options: 'disabled' (store closed), 'beta' (requires passkey), 'live' (open)
NEXT_PUBLIC_CHECKOUT_MODE=live
NEXT_PUBLIC_CHECKOUT_BETA_PASSKEY=saaral-beta-2026

# ─────────────────────────────────────────────────────────────────────────────
# 2. SERVER-ONLY SECRETS (CRITICAL: NEVER PREFIX WITH NEXT_PUBLIC_)
# Keep these strictly on the server (Vercel Environment Variables / .env.local).
# ─────────────────────────────────────────────────────────────────────────────
# Supabase Service Role Key (Bypasses RLS for secure server APIs only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay Key Secret (Used for HMAC-SHA256 signature verification on server)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook Secret (Used to authenticate inbound Razorpay webhook events)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret